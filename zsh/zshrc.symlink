# Shared zshrc (macOS + Arch). OS-specific bits live in zshrc.darwin / zshrc.linux,
# machine-local (untracked) bits in ~/.zshrc.local.

# Directory of the real file (this file is symlinked to ~/.zshrc)
DOTFILES_ZSH="${${(%):-%x}:A:h}"

# --- oh-my-zsh -------------------------------------------------------------
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
plugins=(
	git
	zsh-autosuggestions
	docker
	docker-compose
	ssh-agent
	fzf
	gitignore
	history
	kubectl
	helm
	terraform
)
command -v zoxide >/dev/null || plugins+=(z)   # zoxide replaces omz z when installed
source $ZSH/oh-my-zsh.sh

# --- common env ------------------------------------------------------------
export EDITOR=nvim
export PATH="$PATH:$HOME/.local/share/nvim/mason/bin"
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# --- functions -------------------------------------------------------------
# fzf multi-select of changed files with diff preview -> git add
function gitfa() {
  git -c color.ui=always status --porcelain | \
  fzf --ansi --multi \
      --preview '
        file="$(echo {} | sed "s/^.. //")";
        st="$(echo {} | cut -c1-2)";
        if [ "$st" = "??" ]; then
          command -v bat >/dev/null 2>&1 && bat --style=numbers --color=always -- "$file" || sed -n "1,200p" "$file"
        else
          git diff --color=always -- "$file" | sed -n "1,500p"
        fi
      ' \
      --preview-window=right,60% \
      --bind 'ctrl-d:preview-page-down,ctrl-u:preview-page-up,ctrl-s:toggle-preview' | \
  sed 's/^.. //' | xargs -r git add --
}

[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# --- modern CLI tools (each only if installed; same on Mac via brew) -------
# mise manages node/java/... (replaces fnm + SDKMAN + nvm). Config: ~/.config/mise/config.toml
if command -v mise >/dev/null; then
  eval "$(mise activate zsh)"
else
  command -v fnm >/dev/null && eval "$(fnm env --use-on-cd)"
fi
command -v zoxide   >/dev/null && eval "$(zoxide init zsh)"      # z <dir>, zi = interactive
command -v direnv   >/dev/null && eval "$(direnv hook zsh)"
command -v starship >/dev/null && eval "$(starship init zsh)"    # prompt (overrides ZSH_THEME)
if command -v eza >/dev/null; then
  alias ls='eza --group-directories-first'
  alias ll='eza -l --git --group-directories-first --icons=auto'
  alias la='ll -a'
  alias lt='eza --tree --level=2 --icons=auto'
fi
command -v lazygit >/dev/null && alias lg='lazygit'
export BAT_THEME="Catppuccin Mocha"

# --- per-OS and per-machine -----------------------------------------------
case "$OSTYPE" in
  darwin*) [ -f "$DOTFILES_ZSH/zshrc.darwin" ] && source "$DOTFILES_ZSH/zshrc.darwin" ;;
  linux*)  [ -f "$DOTFILES_ZSH/zshrc.linux" ]  && source "$DOTFILES_ZSH/zshrc.linux" ;;
esac
[ -f ~/.zshrc.local ] && source ~/.zshrc.local

export PATH="$HOME/.local/bin:$PATH"

# SDKMAN only when mise isn't there (mise provides java). Must stay at the end.
if ! command -v mise >/dev/null; then
  export SDKMAN_DIR="$HOME/.sdkman"
  [[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh"
fi
