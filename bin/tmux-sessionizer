#!/usr/bin/env bash

if [[ $# -eq 1 ]]; then
    selected=$1

    # Expand a leading tilde passed through tmux/run-shell (tilde expansion does
    # not occur when '~' comes from a variable).
    if [[ $selected == ~* ]]; then
        selected=${selected/#\~/$HOME}
    fi

    # Normalize to an absolute, existing directory.
    if ! selected=$(cd "$selected" 2>/dev/null && pwd -P); then
        exit 1
    fi
else
    candidates=()

    # Keep the general catalog shallow (no deep recursion).
    [[ -d "$HOME/w" ]] && candidates+=("$(find "$HOME/w" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | grep -v "^$HOME/w/ms$")")
    [[ -d "$HOME/p" ]] && candidates+=("$(find "$HOME/p" -mindepth 1 -maxdepth 1 -type d 2>/dev/null)")

    # Microservices: include both ms root and module folders.
    # Layout: w/ms/<ms-name>/<module>
    [[ -d "$HOME/w/ms" ]] && candidates+=("$(find "$HOME/w/ms" -mindepth 1 -maxdepth 2 -type d 2>/dev/null)")

    selected=$(printf "%s\n" "${candidates[@]}" | sed '/^$/d' | sort -u | fzf)
fi

if [[ -z $selected ]]; then
    exit 0
fi

# Use a path-derived name to avoid collisions (e.g. multiple "api" modules).
selected_name=$(echo "${selected/#$HOME\//}" | tr '/.' '__')
tmux_running=$(pgrep tmux)

if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
    tmux new-session -s $selected_name -c $selected
    exit 0
fi

if ! tmux has-session -t=$selected_name 2> /dev/null; then
    tmux new-session -ds $selected_name -c $selected
fi

tmux switch-client -t $selected_name

