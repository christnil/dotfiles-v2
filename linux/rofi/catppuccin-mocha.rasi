* {
    bg:      #1e1e2ef0;
    bg-alt:  #313244;
    fg:      #cdd6f4;
    fg-alt:  #a6adc8;
    accent:  #cba6f7;
    blue:    #89b4fa;
    background-color: transparent;
    text-color: @fg;
    margin: 0; padding: 0; spacing: 0;
}
window {
    width: 40%;
    background-color: @bg;
    border: 2px;
    border-color: @accent;
    border-radius: 10px;
}
mainbox { padding: 12px; }
inputbar {
    background-color: @bg-alt;
    border-radius: 8px;
    padding: 8px 12px;
    spacing: 8px;
    children: [prompt, entry];
}
prompt { text-color: @accent; }
entry { placeholder: "search"; placeholder-color: @fg-alt; }
message { margin: 8px 0 0; }
textbox { text-color: @fg-alt; }
listview { lines: 10; columns: 1; margin: 10px 0 0; fixed-height: false; }
element { padding: 6px 10px; border-radius: 6px; spacing: 10px; }
element-icon { size: 1.2em; }
element-text { text-color: inherit; }
element selected { background-color: @bg-alt; text-color: @blue; }
